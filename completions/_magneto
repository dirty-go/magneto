#compdef magneto
# Zsh completion for magneto.
#
# Install by adding this file's directory to your fpath before compinit,
# e.g. add to ~/.zshrc (before `autoload -Uz compinit && compinit`):
#   fpath=(/path/to/magneto/completions $fpath)
#
# Or drop it into a directory already on fpath, e.g.:
#   cp completions/_magneto "$(brew --prefix)/share/zsh/site-functions/_magneto"  # Homebrew

_magneto() {
	_arguments \
		'*-magnet[Magnet link; repeat or comma-separate for multiple]:magnet uri:' \
		'-out[Download directory]:directory:_files -/' \
		'-no-seed[Disable seeding after download]:enabled:(true false)' \
		'-parallel[Max simultaneous downloads (0 = unlimited)]:count:' \
		'(-h -help)'{-h,-help}'[Show usage]'
}

_magneto "$@"
